package "ritemMaker"
version "1.0"
purpose "Write a stream of ring items (with body headers) to stdout"

option "datasize" d "Size in bytes of each ring item payload"   int  required
option "sid"      s "Source id placed in the body headers"      int  optional default="0"
option "tsinc"    t "Timestamp increment between events"        int  optional default="1"
option "bufsize"  - "Size in bytes of the ring-item buffer"     long optional default="1048576"
